DATABASE_URL=postgres://localhost/dawere
# Where uploaded photos go. Use an absolute path in production.
UPLOAD_DIR=./uploads
# Signing in with this email makes you the superadmin, who manages admins on /admin.
SUPERADMIN_EMAIL=
# Where readers write for help; shown on /help and in the terms and privacy policy.
SUPPORT_EMAIL=
# The reading chat's OpenAI key (https://platform.openai.com/api-keys). Without it the chat says it isn't working yet.
OPENAI_API_KEY=
# Optional; defaults to gpt-6-luna.
OPENAI_MODEL=

# Docker (read by compose.yaml from a file named .env)
POSTGRES_PASSWORD=change-me
SITE_URL=http://localhost:3000
APP_PORT=3000
