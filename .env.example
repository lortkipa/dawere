# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dawere

# Public origin, used for absolute links in metadata, sitemap.xml and robots.txt.
# Set it before `npm run build` in production.
SITE_URL=http://localhost:3000

# Optional. Where people write about a forgotten password or anything else;
# shown on the sign-in page and in the privacy policy. Leave empty to hide.
SUPPORT_EMAIL=

# Optional. OpenAI API key for "ჰკითხე AI-ს" on articles (model gpt-6-luna).
# Leave empty to hide the button. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Postgres connections per app instance (default 10).
# DATABASE_POOL_MAX=10
