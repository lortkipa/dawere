DATABASE_URL=postgres://localhost/dawere
# Where uploaded photos go. Use an absolute path in production.
UPLOAD_DIR=./uploads
# Signing in with this email makes you the superadmin, who manages admins on /admin.
SUPERADMIN_EMAIL=
# Where readers write for help; shown on /help and in the terms and privacy policy.
SUPPORT_EMAIL=
# The reading chat's OpenAI key (https://platform.openai.com/api-keys). Without it the chat says it isn't working yet.
OPENAI_API_KEY=
# Optional; defaults to gpt-6-luna.
OPENAI_MODEL=
# Sign-in with Google: an OAuth client (type "Web application") from https://console.cloud.google.com/apis/credentials
# with the redirect URI <SITE_URL>/auth/google/callback, e.g. http://localhost:3000/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign-in with Facebook: a Meta app with Facebook Login from https://developers.facebook.com/apps
# with the valid OAuth redirect URI <SITE_URL>/auth/facebook/callback (https; localhost needs none while the app
# is in development mode).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Sending sign-in codes. Without SMTP_HOST the codes go to the server log instead.
# For Gmail: turn on 2-step verification, make an app password at https://myaccount.google.com/apppasswords,
# and use the Gmail address as SMTP_USER. Free Gmail sends to about 500 addresses a day.
# smtp.gmail.com for Gmail.
SMTP_HOST=
# Optional; defaults to 465.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER. E.g. dawere <you@gmail.com>
MAIL_FROM=

# Docker (read by compose.yaml from a file named .env)
POSTGRES_PASSWORD=change-me
SITE_URL=http://localhost:3000
APP_PORT=3000
