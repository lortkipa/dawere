# Postgres from the repo-root docker-compose.yml. Published on 5433 because the
# host may already be running its own Postgres on 5432.
DATABASE_URL=postgresql://dawere:dawere@localhost:5433/dawere

# openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Needed because the dev server is also reached over the LAN (see next.config.ts).
AUTH_TRUST_HOST=true
