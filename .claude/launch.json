        "SUPERADMIN_EMAIL=test@gmail.com",
        "UPLOAD_DIR=./uploads/test",
        "SITE_URL=http://localhost:3100",
        "npx",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100
